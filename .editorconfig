root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,html,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# o NSIS lê o gancho sem BOM na página de código do sistema, não em UTF-8 (D183.20)
[*.nsh]
charset = utf-8-bom
