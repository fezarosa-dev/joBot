root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,html,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# precaução (D183.20): o tauri-bundler chama o makensis com -INPUTCHARSET UTF8, mas sem BOM
# o makensis compilado à mão leria o gancho na página de código do sistema
[*.nsh]
charset = utf-8-bom
